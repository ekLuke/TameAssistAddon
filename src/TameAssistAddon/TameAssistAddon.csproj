    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(VALHEIM_DIR)' != ''">$(VALHEIM_DIR)</ValheimDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TameAssistAddon.Core/TameAssistAddon.Core.csproj"/>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimDir)/BepInEx/core/0Harmony.dll</HintPath>
